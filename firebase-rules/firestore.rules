rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the User UID of the one account that may edit the site
    // (Firebase console > Authentication > Users > User UID).
    function isOwner() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_OWNER_UID";
    }

    match /settings/{doc}  { allow read: if true;  allow write: if isOwner(); }
    match /timeline/{doc}  { allow read: if true;  allow write: if isOwner(); }

    // Visitors can only read published posts and projects. Drafts stay private.
    match /posts/{doc}     { allow read: if resource.data.published == true || isOwner(); allow write: if isOwner(); }
    match /projects/{doc}  { allow read: if resource.data.published == true || isOwner(); allow write: if isOwner(); }

    match /media/{doc}     { allow read, write: if isOwner(); }

    // Contact form: anyone may leave a message of sensible size; only the owner can read or change them.
    match /messages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isOwner();
    }
  }
}
