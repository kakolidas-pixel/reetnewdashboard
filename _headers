# Cloudflare Pages: real HTTP response headers. GitHub Pages couldn't do this, so the CSP
# used to live only in a <meta> tag in each index.html -- that still works as a fallback, but
# a real header also covers frame-ancestors and non-HTML responses, which <meta> can't.
# https://developers.cloudflare.com/pages/configuration/headers/

# A route like /writing/my-post is served as index.html's content via _redirects, but
# Cloudflare matches header rules against the REQUESTED path, not the rewritten one -- so
# the public-site policy has to live on /*, not /index.html, or most routes would miss it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data:; connect-src 'self' https://*.googleapis.com https://*.wikipedia.org; frame-src https:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
  tdm-reservation: 1
  tdm-policy: https://aryamannreet.in/copyright
  # None of the JS/CSS/HTML here are filename-versioned, so without this a browser's own cache
  # can keep serving a pre-deploy copy indefinitely after a push -- no-cache (not no-store)
  # still lets it cache the bytes, it just forces a conditional revalidation every time so a new
  # deploy is picked up on the very next request instead of waiting out a stale TTL.
  Cache-Control: no-cache

# More specific, and listed after /* so its Content-Security-Policy overrides rather than
# merges with the one above.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data:; connect-src 'self' https://*.googleapis.com https://*.wikipedia.org https://api.microlink.io; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
