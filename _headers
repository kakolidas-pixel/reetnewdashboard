# Cloudflare Pages: real HTTP response headers. GitHub Pages couldn't do this, so the CSP
# used to live only in a <meta> tag in each index.html -- that still works as a fallback, but
# a real header also covers frame-ancestors and non-HTML responses, which <meta> can't.
# https://developers.cloudflare.com/pages/configuration/headers/

# A route like /writing/my-post is served as index.html's content via _redirects, but
# Cloudflare matches header rules against the REQUESTED path, not the rewritten one -- so
# the public-site policy has to live on /*, not /index.html, or most routes would miss it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https://*.googleapis.com https://*.wikipedia.org; frame-src https:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# More specific, and listed after /* so its Content-Security-Policy overrides rather than
# merges with the one above.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https://*.googleapis.com https://*.wikipedia.org https://api.microlink.io; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
